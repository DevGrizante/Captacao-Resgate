# Copie para .env e ajuste.

# Fonte de dados:
#   vinculado -> planilha vinculado_*.xlsx que chega por e-mail (padrão hoje)
#   cvm       -> baixa e processa os dados abertos da CVM
#   mock      -> data/mock_fundos.json, com PL/composição SINTÉTICOS (só p/ dev)
DATA_SOURCE=vinculado

# --- Ingestão do e-mail (fonte "vinculado") ---
# O e-mail chega todo dia útil na pasta abaixo do Outlook local. Com
# OUTLOOK_ENABLED=false, o app usa só o que já está em data/inbox/ (útil em
# servidor ou em máquina sem Outlook).
OUTLOOK_ENABLED=true
OUTLOOK_PASTA=Quantum
# VAZIO = qualquer remetente. O relatório é encaminhado por mais de uma pessoa
# da mesa; travar num endereço fazia o app seguir servindo o anexo da véspera,
# sem erro na tela, sempre que outra pessoa mandava o do dia. Preencha para
# restringir de novo (ex.: OUTLOOK_REMETENTE=ottavio.lucca@bgcg.com).
OUTLOOK_REMETENTE=
# Casa por SUBSTRING, sem acento e sem caixa: pega tanto
# "FW: Captação e resgate" quanto o assunto original sem o "FW:".
OUTLOOK_ASSUNTO=Captação e resgate
OUTLOOK_MAX_ITENS=60

# --- CVM: cadastro, PL e métricas ---
# Casa o CNPJ do fundo da planilha com quatro bases da CVM:
#   INF_DIARIO           PL (D-1), rentabilidade, volatilidade, cotistas  ~80%
#   PERFIL_MENSAL        % crédito privado, prazo carteira, cotistas      ~83%
#   EXTRATO              taxa adm, cotização, aplicação mínima, público   ~69%
#   registro_fundo_classe  gestor, administrador, ANBIMA                  ~92%
CVM_ENRIQUECER=true
CVM_CADASTRO_TTL_HORAS=24

# Informe diário. 7 meses dá série para a janela de 6 meses de rentabilidade.
CVM_INFORME_MESES=7
CVM_INFORME_TTL_HORAS=12
CVM_RENTAB_DIAS_MIN=150
CVM_PL_VAR_DIAS=30
# Teto de sanidade da taxa de adm (% a.a.) — o campo chega a 40.000 na CVM
CVM_TAXA_ADM_TETO=10

# O EXTRATO é ANUAL (o fundo declara uma vez por ano): unir 5 anos leva a
# cobertura de 13,7% para 68,9%. O PERFIL é mensal mas nem todo fundo declara
# todo mês: unir 6 meses leva de 7,8% para 82,8%.
CVM_EXTRATO_ANOS=5
CVM_PERFIL_MESES=6
CVM_DOCUMENTOS_TTL_HORAS=24

# Piso de credibilidade do PL (R$). As bases têm valores de placeholder que,
# divididos pelo fluxo, gerariam percentuais absurdos.
CVM_PL_MINIMO=100000
CVM_TIMEOUT_S=180

# --- Composição da carteira: é o que gera o bucket IPCA+/CDI+/LF/Misto ---
# Vem do CDA da CVM cruzado com o registro de debêntures do SND (o CDA
# identifica a debênture só pelo código e não diz o indexador).
# A DEFASAGEM É PROPOSITAL: no CDA do mês corrente 46% do PL do universo está
# sob sigilo, e o que sobra é amostra enviesada. Com 4 meses o sigilo zera e a
# carteira visível dobra (R$ 738 bi -> R$ 1.617 bi). Reduzir isto piora o dado.
CDA_DEFASAGEM_MESES=4
CDA_TTL_HORAS=24
# Guardas POR FUNDO. Quem não passa fica "sem classificação" — nunca com bucket
# adivinhado, porque MISTO significa "olhamos e nada domina", não "não olhamos".
CDA_IDX_MINIMO_PCT=80        # % da carteira com indexador conhecido
CDA_SIGILO_MAXIMO_PCT=20     # % do PL sob sigilo tolerado
CDA_CREDITO_MINIMO_PCT=10    # % do PL em crédito para o bucket descrever o fundo
SND_TTL_HORAS=168

# --- Perfil de indexador observado (NÃO é o bucket) ---
# Mede a exposição do cotista (benchmark declarado, ou comportamento da cota),
# não a composição da carteira. As duas divergem: 1/3 dos fundos com carteira
# IPCA+ entrega retorno de pós-fixado ao cotista, porque travam em CDI via swap.
# Com false, ficam só os ~24% que declaram benchmark.
PERFIL_INDEXADOR_INFERIR=true
# Volatilidade anualizada: abaixo da baixa = pós, acima da alta = inflação.
# No meio o acerto cai de 87% para 77%, e preferimos devolver vazio.
PERFIL_VOL_ZONA_BAIXA=2.5
PERFIL_VOL_ZONA_ALTA=5.0

# --- Universo: crédito privado ---
# todos   = não filtra
# sinal   = qualquer indício (perfil CVM, extrato CVM, ANBIMA ou nome) [padrão]
# estrito = só o % declarado à CVM, acima do limiar
CREDITO_PRIVADO_MODO=sinal
CREDITO_PRIVADO_LIMIAR=5

# --- CVM: fonte alternativa (DATA_SOURCE=cvm) ---
CVM_BASE_URL=https://dados.cvm.gov.br/dados/FI/DOC
CVM_MESES_INFORME=7

# --- Quantum Axis (enriquecimento) ---
# Deixe false até ter endpoint/token. Quando ativar, implemente _chamar_api
# em app/connectors/quantum_connector.py conforme seu contrato. É o Quantum
# que preenche PL, composição por indexador, duration, cotização, taxa de
# administração e status de captação — até lá, esses campos vêm vazios.
QUANTUM_ENABLED=false
QUANTUM_BASE_URL=https://api.quantumaxis.com.br
QUANTUM_TOKEN=

# --- Regras de negócio: classificação de fundos ---
# Corte único da classificação, em FRAÇÃO da carteira (0..1).
#   > este valor em Letras Financeiras  -> o fundo é LF
#   caso contrário, é fundo de crédito e vai para a dupla verificação
#     Incentivada  = nome traz "Incentivada/o" E carteira opera IPCA+
#     Tradicional  = nome não traz E carteira atrelada a CDI+
# Editável em tempo de execução pelo painel de controle (frontend/admin.html);
# o que o painel gravar em data/parametros.json tem precedência sobre isto.
THRESHOLD_MAJORITARIO=0.2

# --- Hedge em DAP: a perna que define "comportamento de IPCA+" ---
# O fundo de debênture incentivada compra o papel em B + spread e vende cupom
# de IPCA no futuro de DAP, ficando só com o spread de crédito. HEDGE_DAP_MINIMO
# é o nocional em DAP sobre o R$ da carteira IPCA+ a partir do qual chamamos
# isso de hedge. Medido no CDA de 2026-04, entre os fundos com posição em DAP a
# cobertura tem mediana 0,75 e p10 0,20 — abaixo disso a posição é residual.
HEDGE_DAP_MINIMO=0.2
# Face do contrato futuro de DAP na B3. O CDA informa contratos e ajuste a
# mercado, nunca o nocional — ele é reconstruído a partir daqui.
DAP_NOCIONAL_CONTRATO=100000
# Com false, nome de incentivada + carteira IPCA+ bastam, sem exigir o hedge.
# Com true (padrão), o fundo que compra IPCA+ e NÃO trava em DAP cai em Misto:
# ele carrega juro real na cota, que é outro produto para a mesa.
INCENTIVADA_EXIGE_HEDGE_DAP=false

# Estresse com PL disponível: resgate acima desta fração do PL.
THRESHOLD_STRESS=0.05
# Estresse sem PL: resgate acima de STRESS_MULTIPLO vezes o movimento típico
# do fundo nas últimas STRESS_SEMANAS_BASE semanas, e acima do piso absoluto.
STRESS_SEMANAS_BASE=13
STRESS_MULTIPLO=2.0
STRESS_MINIMO_ABS=10000000

# --- Cache ---
CACHE_TTL_HORAS=12

# --- CORS (origens do front) ---
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# PL minimo (R$) para uma gestora aparecer no painel "Top movers"
MOVERS_PL_MINIMO=100000000

# =============================================================================
# --- MySQL local (docker) ---
# =============================================================================
# O banco sobe em ../infra/docker-compose.yml e e compartilhado com o projeto
# CVM Monitor PRO, cada um no seu schema.
#
# ATENCAO ao host:
#   mysql       -> de DENTRO de um container (nome do servico na rede bgc-net)
#   127.0.0.1   -> da sua maquina, rodando o app fora do Docker
#
# A porta tambem muda conforme o lado: 3306 dentro da rede Docker, 3307 no
# host (para nao colidir com um MySQL ja instalado na maquina).
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=captacao_resgate
DB_USER=captacao_app
DB_PASSWORD=captacao_dev_2026

# String de conexao pronta (SQLAlchemy + PyMySQL). Para usar, acrescente
# `SQLAlchemy>=2.0` e `PyMySQL>=1.1` ao backend/requirements.txt.
# charset=utf8mb4 e obrigatorio: nome de gestora tem acento.
DATABASE_URL=mysql+pymysql://captacao_app:captacao_dev_2026@127.0.0.1:3307/captacao_resgate?charset=utf8mb4

# Dentro do container (o docker-compose.yml ja injeta este valor):
# DATABASE_URL=mysql+pymysql://captacao_app:captacao_dev_2026@mysql:3306/captacao_resgate?charset=utf8mb4

# =============================================================================
# --- Ingestao da planilha pela rede (POST /api/inbox) ---
# =============================================================================
# Permite que a planilha do e-mail chegue por HTTP em vez de pelo Outlook
# local. E o que torna o painel rodavel em servidor: no Linux nao existe COM,
# entao a maquina que TEM Outlook empurra o arquivo para dentro, com o
# backend/scripts/coletar_vinculado.py (ver Coletar_e_Enviar.bat).
#
# VAZIO = INGESTAO DESLIGADA, e nao aberta. Os tres endpoints respondem 503
# enquanto nao houver token. Um upload sem autenticacao seria pior que nao ter
# upload nenhum: quem alcancasse a URL passaria a decidir que numeros a mesa ve.
#
# O MESMO valor precisa estar nos dois lados - no .env do servidor e no da
# maquina que coleta. Para gerar outro:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
INGESTAO_TOKEN=

# Para onde o coletor publica. Na maquina que le o Outlook, aponte para o
# servidor: INGESTAO_DESTINO=https://painel.suaempresa.com
INGESTAO_DESTINO=http://127.0.0.1:8000

# Teto do corpo aceito no upload (MB). A planilha tem ~1,2 MB.
INGESTAO_TAMANHO_MAXIMO_MB=25

# Quantas planilhas manter em data/inbox/. Uma por dia util ~ 1,2 MB/dia, o que
# em um ano encheria 300 MB de um disco de VPS sem ninguem perceber. 0 = todas.
INGESTAO_MANTER_ARQUIVOS=60

# =============================================================================
# --- Senha do painel ---
# =============================================================================
# Uma senha so, igual para todo mundo. E o minimo para publicar o painel num
# endereco alcancavel: sem ela, quem descobrir a URL ve fluxo por gestora e
# pode alterar o corte de classificacao para todos.
#
# ISTO NAO E CONTROLE POR PESSOA. O log nao sabe quem fez o que, e tirar o
# acesso de alguem significa trocar a senha de todos. A etapa seguinte, ja
# prevista, e usuario por usuario com banco.
#
# VAZIO = SEM SENHA. Aceitavel em 127.0.0.1 na propria maquina; num servidor
# alcancavel, preencher e obrigatorio. O app avisa no log ao subir se estiver
# vazio.
PAINEL_SENHA=

# Assina o cookie de sessao. Sem valor, e sorteado a cada partida e todo mundo
# cai no reinicio do servico. NUNCA use o mesmo valor de outra instalacao.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PAINEL_SEGREDO=

# Duracao da sessao. 12h cobre o dia de mesa sem pedir senha no meio.
PAINEL_SESSAO_HORAS=12

# Marca o cookie como Secure (so trafega em HTTPS).
#   false -> desenvolvimento em http://127.0.0.1
#   true  -> servidor com HTTPS. Em http, o navegador descarta o cookie e o
#            login entra em laco infinito.
PAINEL_COOKIE_SEGURO=false
