# Copie para .env e ajuste.

# Fonte de dados:
#   vinculado -> planilha vinculado_*.xlsx que chega por e-mail (padrão hoje)
#   cvm       -> baixa e processa os dados abertos da CVM
#   mock      -> data/mock_fundos.json, com PL/composição SINTÉTICOS (só p/ dev)
DATA_SOURCE=vinculado

# --- Ingestão do e-mail (fonte "vinculado") ---
# O e-mail chega todo dia útil na pasta abaixo do Outlook local. Com
# OUTLOOK_ENABLED=false, o app usa só o que já está em data/inbox/ (útil em
# servidor ou em máquina sem Outlook).
OUTLOOK_ENABLED=true
OUTLOOK_PASTA=Quantum
OUTLOOK_REMETENTE=ottavio.lucca@bgcg.com
OUTLOOK_ASSUNTO=Captação e resgate
OUTLOOK_MAX_ITENS=60

# --- CVM: cadastro, PL e métricas ---
# Casa o CNPJ do fundo da planilha com quatro bases da CVM:
#   INF_DIARIO           PL (D-1), rentabilidade, volatilidade, cotistas  ~80%
#   PERFIL_MENSAL        % crédito privado, prazo carteira, cotistas      ~83%
#   EXTRATO              taxa adm, cotização, aplicação mínima, público   ~69%
#   registro_fundo_classe  gestor, administrador, ANBIMA                  ~92%
CVM_ENRIQUECER=true
CVM_CADASTRO_TTL_HORAS=24

# Informe diário. 7 meses dá série para a janela de 6 meses de rentabilidade.
CVM_INFORME_MESES=7
CVM_INFORME_TTL_HORAS=12
CVM_RENTAB_DIAS_MIN=150
CVM_PL_VAR_DIAS=30
# Teto de sanidade da taxa de adm (% a.a.) — o campo chega a 40.000 na CVM
CVM_TAXA_ADM_TETO=10

# O EXTRATO é ANUAL (o fundo declara uma vez por ano): unir 5 anos leva a
# cobertura de 13,7% para 68,9%. O PERFIL é mensal mas nem todo fundo declara
# todo mês: unir 6 meses leva de 7,8% para 82,8%.
CVM_EXTRATO_ANOS=5
CVM_PERFIL_MESES=6
CVM_DOCUMENTOS_TTL_HORAS=24

# Piso de credibilidade do PL (R$). As bases têm valores de placeholder que,
# divididos pelo fluxo, gerariam percentuais absurdos.
CVM_PL_MINIMO=100000
CVM_TIMEOUT_S=180

# --- Composição da carteira: é o que gera o bucket IPCA+/CDI+/LF/Misto ---
# Vem do CDA da CVM cruzado com o registro de debêntures do SND (o CDA
# identifica a debênture só pelo código e não diz o indexador).
# A DEFASAGEM É PROPOSITAL: no CDA do mês corrente 46% do PL do universo está
# sob sigilo, e o que sobra é amostra enviesada. Com 4 meses o sigilo zera e a
# carteira visível dobra (R$ 738 bi -> R$ 1.617 bi). Reduzir isto piora o dado.
CDA_DEFASAGEM_MESES=4
CDA_TTL_HORAS=24
# Guardas POR FUNDO. Quem não passa fica "sem classificação" — nunca com bucket
# adivinhado, porque MISTO significa "olhamos e nada domina", não "não olhamos".
CDA_IDX_MINIMO_PCT=80        # % da carteira com indexador conhecido
CDA_SIGILO_MAXIMO_PCT=20     # % do PL sob sigilo tolerado
CDA_CREDITO_MINIMO_PCT=10    # % do PL em crédito para o bucket descrever o fundo
SND_TTL_HORAS=168

# --- Perfil de indexador observado (NÃO é o bucket) ---
# Mede a exposição do cotista (benchmark declarado, ou comportamento da cota),
# não a composição da carteira. As duas divergem: 1/3 dos fundos com carteira
# IPCA+ entrega retorno de pós-fixado ao cotista, porque travam em CDI via swap.
# Com false, ficam só os ~24% que declaram benchmark.
PERFIL_INDEXADOR_INFERIR=true
# Volatilidade anualizada: abaixo da baixa = pós, acima da alta = inflação.
# No meio o acerto cai de 87% para 77%, e preferimos devolver vazio.
PERFIL_VOL_ZONA_BAIXA=2.5
PERFIL_VOL_ZONA_ALTA=5.0

# --- Universo: crédito privado ---
# todos   = não filtra
# sinal   = qualquer indício (perfil CVM, extrato CVM, ANBIMA ou nome) [padrão]
# estrito = só o % declarado à CVM, acima do limiar
CREDITO_PRIVADO_MODO=sinal
CREDITO_PRIVADO_LIMIAR=5

# --- CVM: fonte alternativa (DATA_SOURCE=cvm) ---
CVM_BASE_URL=https://dados.cvm.gov.br/dados/FI/DOC
CVM_MESES_INFORME=7

# --- Quantum Axis (enriquecimento) ---
# Deixe false até ter endpoint/token. Quando ativar, implemente _chamar_api
# em app/connectors/quantum_connector.py conforme seu contrato. É o Quantum
# que preenche PL, composição por indexador, duration, cotização, taxa de
# administração e status de captação — até lá, esses campos vêm vazios.
QUANTUM_ENABLED=false
QUANTUM_BASE_URL=https://api.quantumaxis.com.br
QUANTUM_TOKEN=

# --- Regras de negócio ---
THRESHOLD_MAJORITARIO=0.5

# Estresse com PL disponível: resgate acima desta fração do PL.
THRESHOLD_STRESS=0.05
# Estresse sem PL: resgate acima de STRESS_MULTIPLO vezes o movimento típico
# do fundo nas últimas STRESS_SEMANAS_BASE semanas, e acima do piso absoluto.
STRESS_SEMANAS_BASE=13
STRESS_MULTIPLO=2.0
STRESS_MINIMO_ABS=10000000

# --- Cache ---
CACHE_TTL_HORAS=12

# --- CORS (origens do front) ---
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# PL minimo (R$) para uma gestora aparecer no painel "Top movers"
MOVERS_PL_MINIMO=100000000
