# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Ambiente
.env

# Cache de dados (baixados da CVM)
data/cache/*
!data/cache/.gitkeep

# Anexos vinculado_*.xlsx baixados do e-mail — dado de cliente, não versionar
data/inbox/*
!data/inbox/.gitkeep

# Relatórios gerados (scripts/relatorio_cobertura.py)
data/relatorios/

# Parâmetros gravados pelo painel de controle. É estado local da máquina: o
# valor que o projeto entrega vive em backend/.env.example.
data/parametros.json
data/parametros.json.tmp

# frontend/js/config.js NAO fica mais aqui.
#
# Ele era ignorado porque guardava a porta da maquina ("http://127.0.0.1:8001").
# Desde que a API passou a servir o painel, o conteudo virou o mesmo em todo
# lugar: API_BASE vazio, ou seja, mesma origem. Ignorado, ele faltava no clone
# do servidor, o /js/config.js dava 404 e o painel caia no padrao antigo -
# "localhost:8000", que no navegador do usuario e a maquina DELE.

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Docker
.env.docker

# Dependencias do build do CSS. So quem MUDA classe do painel precisa delas;
# o CSS gerado (frontend/css/tailwind.css) esta versionado, entao quem so quer
# rodar o painel nao precisa de Node.
frontend/build/node_modules/
frontend/build/package-lock.json

# Log do coletor diario. Estado local da maquina que roda a coleta.
data/logs/
