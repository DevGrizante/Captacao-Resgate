# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Ambiente
.env

# Cache de dados (baixados da CVM)
data/cache/*
!data/cache/.gitkeep

# Anexos vinculado_*.xlsx baixados do e-mail — dado de cliente, não versionar
data/inbox/*
!data/inbox/.gitkeep

# Relatórios gerados (scripts/analise/relatorio_cobertura.py, scripts/analise/conciliar_cnpjs.py)
data/relatorios/

# Saídas do scripts/analise/b3_balcao.py. São recortes de um dia de mercado, sempre
# regeneráveis pelo script — versionar congelava 1,6 MB de um dia específico
# no repositório sem que ninguém voltasse a olhar para ele.
data/b3/

# O mock (6,4 MB) é regenerado por `python backend/scripts/analise/gerar_mock.py`.
# Ele nasce de um vinculado_*.xlsx, ou seja, é DERIVADO de dado de cliente —
# e era o maior arquivo do repositório, sozinho maior que todo o código.
data/mock_fundos.json

# Base histórica de debêntures da B3 (backend/scripts/analise/b3_historico_deb.py).
# São dezenas de MB baixados da API pública, sempre regeneráveis pelo script —
# versionar congelaria no repositório um recorte que envelhece todo dia.
data/Base_DEB/

# Cache de ferramentas (ruff e pytest). Concentrados em .cache/ pelo
# pyproject.toml; os dois nomes antigos ficam listados para quem tiver as
# pastas de antes da mudança de 21/08/2026.
.cache/
.pytest_cache/
.ruff_cache/

# Parâmetros gravados pelo painel de controle. É estado local da máquina: o
# valor que o projeto entrega vive em backend/.env.example.
data/parametros.json
data/parametros.json.tmp

# frontend/js/config.js NAO fica mais aqui.
#
# Ele era ignorado porque guardava a porta da maquina ("http://127.0.0.1:8001").
# Desde que a API passou a servir o painel, o conteudo virou o mesmo em todo
# lugar: API_BASE vazio, ou seja, mesma origem. Ignorado, ele faltava no clone
# do servidor, o /js/config.js dava 404 e o painel caia no padrao antigo -
# "localhost:8000", que no navegador do usuario e a maquina DELE.

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Docker
.env.docker

# Dependencias do build do CSS. So quem MUDA classe do painel precisa delas;
# o CSS gerado (frontend/css/tailwind.css) esta versionado, entao quem so quer
# rodar o painel nao precisa de Node.
frontend/build/node_modules/
frontend/build/package-lock.json

# Log do coletor diario. Estado local da maquina que roda a coleta.
data/logs/
