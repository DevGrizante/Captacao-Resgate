# O cmd.exe e sensivel a terminador de linha em bloco `( ... )` e em `goto`.
# Este projeto ja perdeu uma tarde por causa de um .bat com LF. Independente do
# core.autocrlf de quem clonar, .bat sai CRLF no disco.
*.bat text eol=crlf

# Arquivos que o Linux LE: CRLF aqui e erro, nao inconveniencia.
# Um .sh com CRLF falha com "bad interpreter: /usr/bin/env bash^M", mensagem
# que nao tem nada a ver com a causa. Uma unidade do systemd com CRLF e
# recusada sem explicar direito o motivo.
*.sh            text eol=lf
*.service       text eol=lf
Caddyfile       text eol=lf
Dockerfile      text eol=lf
*.conf          text eol=lf
# O cloud-init e YAML lido pelo boot da VM: CRLF quebra os blocos de runcmd.
# `*.yml` NAO casa com `.yaml` - precisa das duas linhas.
*.yaml          text eol=lf

# O resto normaliza para LF no repositorio.
*.py   text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yml  text eol=lf

# Binarios e dados: nunca converter.
*.xlsx   binary
*.parquet binary
*.png    binary
*.ico    binary
